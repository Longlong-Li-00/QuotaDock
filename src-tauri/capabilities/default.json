{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The QuotaDock page may only call its 18 narrow app commands. No shell, fs, process, SQL, RPC, notification, autostart or tray permissions are granted to the webview; those plugins are used from Rust only.",
  "windows": ["main"],
  "permissions": [
    "allow-get-dashboard",
    "allow-get-current-usage",
    "allow-get-usage-forecast",
    "allow-refresh-usage",
    "allow-get-usage-history",
    "allow-get-quota-events",
    "allow-get-provider-status",
    "allow-pause-monitoring",
    "allow-resume-monitoring",
    "allow-get-settings",
    "allow-update-settings",
    "allow-acknowledge-close-hint",
    "allow-open-data-folder",
    "allow-export-diagnostics",
    "allow-quit-app",
    "allow-get-claude-integration",
    "allow-enable-claude-integration",
    "allow-disable-claude-integration"
  ]
}
