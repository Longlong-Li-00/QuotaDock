{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "QuotaDock",
    "copyright": "Copyright © 2026 QuotaDock",
    "category": "Utility",
    "shortDescription": "Local, read-only quota monitor for Codex and Claude",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "useLocalToolsDir": true,
    "externalBin": ["binaries/quotadock-claude-bridge"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "customLanguageFiles": {
          "SimpChinese": "windows/languages/SimpChinese.nsh",
          "English": "windows/languages/English.nsh"
        },
        "displayLanguageSelector": false
      }
    }
  }
}
